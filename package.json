{
  "name": "zotero-reader-local-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "test:runtime": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "runtime:setup": "python3 scripts/setup_runtime.py --precision Q4_K_M",
    "runtime:start": "python3 scripts/serve.py",
    "experiment": "node --experimental-strip-types scripts/experiment.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "katex": "0.18.9",
    "markdown-it": "15.0.2"
  }
}
