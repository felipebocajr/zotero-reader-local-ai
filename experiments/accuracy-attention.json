{
  "version": 1,
  "paper": "attention",
  "source": "arXiv:1706.03762v1",
  "description": "Input/output accuracy suite over the real paper Attention Is All You Need. Each answer is generated with the full paper, the production prompt and the selected response language. Checks are explicit facts, forbidden inventions, language and instruction adherence.",
  "cases": [
    {
      "id": "attention-definition",
      "paper": "attention",
      "category": "concept",
      "selectionPhrase": "Scaled Dot-Product Attention",
      "question": "Explain how scaled dot-product attention computes its output, and why the scaling factor is used.",
      "responseLanguage": "en",
      "expected": "Queries and keys produce compatibility scores; the scores are divided by sqrt(d_k); softmax gives weights; the output is a weighted sum of values. Scaling avoids very large dot products and unstable gradients.",
      "checks": [
        {
          "id": "query-key-score",
          "category": "content",
          "kind": "required",
          "patterns": ["query.{0,100}key|key.{0,100}query|\\bq\\b.{0,50}\\bk\\b|consulta.{0,100}chave"],
          "description": "Relaciona queries e keys."
        },
        {
          "id": "dot-product",
          "category": "content",
          "kind": "required",
          "patterns": ["dot[- ]product|qk\\s*\\^?\\s*t|\\bq\\s*k\\s*\\^?\\s*t\\b|produto escalar"],
          "description": "Identifica o produto escalar entre query e key."
        },
        {
          "id": "sqrt-dk",
          "category": "content",
          "kind": "required",
          "patterns": ["sqrt|square root|√|raiz"],
          "description": "Menciona a divisão pela raiz de d_k."
        },
        {
          "id": "softmax",
          "category": "content",
          "kind": "required",
          "patterns": ["softmax"],
          "description": "Menciona softmax."
        },
        {
          "id": "weighted-values",
          "category": "content",
          "kind": "required",
          "patterns": ["weight.{0,100}value|value.{0,100}weight|sum.{0,100}value|softmax.{0,240}v\\b|pondera.{0,100}valor|combina.{0,100}valor|sum.{0,160}\\\\?v\\b"],
          "description": "Explica a soma ponderada dos values."
        },
        {
          "id": "max-150-words",
          "category": "instruction",
          "kind": "max_words",
          "max": 150,
          "description": "Respeita o limite de 150 palavras do prompt."
        },
        {
          "id": "english",
          "category": "language",
          "kind": "language",
          "expected": "en",
          "description": "Responde em inglês, o padrão do plugin."
        }
      ]
    },
    {
      "id": "attention-scaling",
      "paper": "attention",
      "category": "concept",
      "selectionPhrase": "divide each by",
      "question": "Why does the paper divide the dot products by sqrt(d_k)? What happens without this scaling?",
      "responseLanguage": "en",
      "expected": "Large dot products make the softmax extremely peaked or saturated, producing very small gradients. Dividing by sqrt(d_k) keeps the scores in a useful range and stabilizes training.",
      "checks": [
        {
          "id": "large-dot-products",
          "category": "content",
          "kind": "required",
          "patterns": ["large.{0,120}dot|dot.{0,120}large|grow.{0,120}large|magnitude.{0,120}(large|grow)|produto escalar.{0,120}(grande|aument)"],
